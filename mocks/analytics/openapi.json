{
  "components": {
    "schemas": {
      "ClockPush": {
        "properties": {
          "rev": {
            "title": "Rev",
            "type": "integer"
          },
          "state": {
            "additionalProperties": true,
            "title": "State",
            "type": "object"
          }
        },
        "required": [
          "state",
          "rev"
        ],
        "title": "ClockPush",
        "type": "object"
      },
      "FaultConfig": {
        "properties": {
          "drop_pct": {
            "default": 0.0,
            "description": "Outbound messages silently dropped",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Drop Pct",
            "type": "number"
          },
          "dup_pct": {
            "default": 0.0,
            "description": "Outbound messages sent twice",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Dup Pct",
            "type": "number"
          },
          "error_pct": {
            "default": 0.0,
            "description": "Non-admin requests fail with 500",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Error Pct",
            "type": "number"
          },
          "jitter_ms": {
            "default": 0,
            "maximum": 60000.0,
            "minimum": 0.0,
            "title": "Jitter Ms",
            "type": "integer"
          },
          "latency_ms": {
            "default": 0,
            "description": "Added latency on every non-admin request",
            "maximum": 60000.0,
            "minimum": 0.0,
            "title": "Latency Ms",
            "type": "integer"
          },
          "outage": {
            "default": false,
            "description": "All non-admin endpoints return 503; sessions refuse logon",
            "title": "Outage",
            "type": "boolean"
          },
          "reorder_pct": {
            "default": 0.0,
            "description": "Outbound messages held and sent after the next",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Reorder Pct",
            "type": "number"
          }
        },
        "title": "FaultConfig",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "KeyChange": {
        "properties": {
          "plan": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
