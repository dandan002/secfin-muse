{
  "components": {
    "schemas": {
      "AdvanceRequest": {
        "properties": {
          "seconds": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seconds"
          },
          "to": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "To"
          }
        },
        "title": "AdvanceRequest",
        "type": "object"
      },
      "ClockPush": {
        "properties": {
          "rev": {
            "title": "Rev",
            "type": "integer"
          },
          "state": {
            "additionalProperties": true,
            "title": "State",
            "type": "object"
          }
        },
        "required": [
          "state",
          "rev"
        ],
        "title": "ClockPush",
        "type": "object"
      },
      "ClockUpdate": {
        "properties": {
          "mode": {
            "anyOf": [
              {
                "enum": [
                  "live",
                  "stepped"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mode"
          },
          "paused": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Paused"
          },
          "speed": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "maximum": 10000.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Speed"
          }
        },
        "title": "ClockUpdate",
        "type": "object"
      },
      "FaultConfig": {
        "properties": {
          "drop_pct": {
            "default": 0.0,
            "description": "Outbound messages silently dropped",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Drop Pct",
            "type": "number"
          },
          "dup_pct": {
            "default": 0.0,
            "description": "Outbound messages sent twice",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Dup Pct",
            "type": "number"
          },
          "error_pct": {
            "default": 0.0,
            "description": "Non-admin requests fail with 500",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Error Pct",
            "type": "number"
          },
          "jitter_ms": {
            "default": 0,
            "maximum": 60000.0,
            "minimum": 0.0,
            "title": "Jitter Ms",
            "type": "integer"
          },
          "latency_ms": {
            "default": 0,
            "description": "Added latency on every non-admin request",
            "maximum": 60000.0,
            "minimum": 0.0,
            "title": "Latency Ms",
            "type": "integer"
          },
          "outage": {
            "default": false,
            "description": "All non-admin endpoints return 503; sessions refuse logon",
            "title": "Outage",
            "type": "boolean"
          },
          "reorder_pct": {
            "default": 0.0,
            "description": "Outbound messages held and sent after the next",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Reorder Pct",
            "type": "number"
          }
        },
        "title": "FaultConfig",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "JumpRequest": {
        "properties": {
          "to": {
            "description": "ISO 8601 timestamp, e.g. 2026-10-27T09:00:00-04:00",
            "title": "To",
            "type": "string"
          }
        },
        "required": [
          "to"
        ],
        "title": "JumpRequest",
        "type": "object"
      },
      "ResetAll": {
        "properties": {
          "epoch": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Sim start time; default 2026-10-27T08:55-04:00",
            "title": "Epoch"
          },
          "mode": {
            "default": "live",
            "enum": [
              "live",
              "stepped"
            ],
            "title": "Mode",
            "type": "string"
          },
          "paused": {
            "default": true,
            "title": "Paused",
            "type": "boolean"
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed"
          },
          "speed": {
            "default": 1.0,
            "title": "Speed",
            "type": "number"
          }
        },
        "title": "ResetAll",
        "type": "object"
      },
      "ResetRequest": {
        "properties": {
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed"
          }
        },
        "title": "ResetRequest",
        "type": "object"
      },
      "RunRequest": {
        "properties": {
          "mode": {
            "default": "stepped",
            "enum": [
              "live",
              "stepped"
            ],
            "title": "Mode",
            "type": "string"
          },
          "reset": {
            "default": true,
            "title": "Reset",
            "type": "boolean"
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed"
          },
          "speed": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Live mode only; default from the file",
            "title": "Speed"
          }
        },
        "title": "RunRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Sim clock, seeded resets, fault toggles and scenario runner for every mock.\n\n**Simulator for demonstration only. Not affiliated with or endorsed by EquiLend, Wematch, FIS or Bloomberg; all names are trademarks of their respective owners. All data is synthetic.**",
    "title": "Simulation Control \u2014 mock-control",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
