{
  "components": {
    "schemas": {
      "ClockPush": {
        "properties": {
          "rev": {
            "title": "Rev",
            "type": "integer"
          },
          "state": {
            "additionalProperties": true,
            "title": "State",
            "type": "object"
          }
        },
        "required": [
          "state",
          "rev"
        ],
        "title": "ClockPush",
        "type": "object"
      },
      "CounterBody": {
        "properties": {
          "feeBps": {
            "minimum": 0.0,
            "title": "Feebps",
            "type": "number"
          },
          "quantity": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Quantity"
          }
        },
        "required": [
          "feeBps"
        ],
        "title": "CounterBody",
        "type": "object"
      },
      "FaultConfig": {
        "properties": {
          "drop_pct": {
            "default": 0.0,
            "description": "Outbound messages silently dropped",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Drop Pct",
            "type": "number"
          },
          "dup_pct": {
            "default": 0.0,
            "description": "Outbound messages sent twice",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Dup Pct",
            "type": "number"
          },
          "error_pct": {
            "default": 0.0,
            "description": "Non-admin requests fail with 500",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Error Pct",
            "type": "number"
          },
          "jitter_ms": {
            "default": 0,
            "maximum": 60000.0,
            "minimum": 0.0,
            "title": "Jitter Ms",
            "type": "integer"
          },
          "latency_ms": {
            "default": 0,
            "description": "Added latency on every non-admin request",
            "maximum": 60000.0,
            "minimum": 0.0,
            "title": "Latency Ms",
            "type": "integer"
          },
          "outage": {
            "default": false,
            "description": "All non-admin endpoints return 503; sessions refuse logon",
            "title": "Outage",
            "type": "boolean"
          },
          "reorder_pct": {
            "default": 0.0,
            "description": "Outbound messages held and sent after the next",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Reorder Pct",
            "type": "number"
          }
        },
        "title": "FaultConfig",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "OrderRequest": {
        "properties": {
          "bookingEntity": {
            "maxLength": 64,
            "title": "Bookingentity",
            "type": "string"
          },
          "clientOrderId": {
            "maxLength": 64,
            "title": "Clientorderid",
            "type": "string"
          },
          "collateralCcy": {
            "maxLength": 3,
            "minLength": 3,
            "title": "Collateralccy",
            "type": "string"
          },
          "collateralType": {
            "enum": [
              "CASH",
              "NONCASH"
            ],
            "title": "Collateraltype",
            "type": "string"
          },
          "counterpartyCode": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Venue code of the contra; omit to hit the best lender",
            "title": "Counterpartycode"
          },
          "feeBps": {
            "maximum": 100000.0,
            "minimum": 0.0,
            "title": "Feebps",
            "type": "number"
          },
          "instrument": {
            "description": "ISIN, SEDOL, CUSIP, FIGI or 'TICK XX'",
            "title": "Instrument",
            "type": "string"
          },
          "legalAgreement": {
            "enum": [
              "MSLA",
              "GMSLA_2010",
              "GMSLA_2018"
            ],
            "title": "Legalagreement",
            "type": "string"
          },
          "marginPct": {
            "maximum": 150.0,
            "minimum": 100.0,
            "title": "Marginpct",
            "type": "number"
          },
          "quantity": {
            "exclusiveMinimum": 0.0,
            "maximum": 500000000.0,
            "title": "Quantity",
            "type": "integer"
          },
          "settlementDate": {
            "format": "date",
            "title": "Settlementdate",
            "type": "string"
          },
          "term": {
            "default": "OPEN",
            "enum": [
              "OPEN",
              "TERM"
            ],
            "title": "Term",
            "type": "string"
          },
          "termEndDate": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Termenddate"
          },
          "ttlSeconds": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "maximum": 86400.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ttlseconds"
          },
          "type": {
            "enum": [
              "BID",
              "OFFER",
              "FIRM_BID"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "clientOrderId",
          "type",
          "instrument",
          "quantity",
          "feeBps",
          "collateralType",
          "collateralCcy",
          "marginPct",
          "settlementDate",
          "legalAgreement",
          "bookingEntity"
        ],
        "title": "OrderRequest",
        "type": "object"
      },
      "ResetRequest": {
        "properties": {
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed"
          }
        },
        "title": "ResetRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VenueConfig": {
        "properties": {
          "counter_band": {
            "default": 0.8,
            "description": "Bids at or above ask*band get a counter instead of a reject",
            "title": "Counter Band",
            "type": "number"
          },
          "default_ttl_s": {
            "default": 900,
            "title": "Default Ttl S",
            "type": "integer"
          },
          "feed_every_s": {
            "default": 5.0,
            "title": "Feed Every S",
            "type": "number"
          },
          "hot_spread": {
            "default": [
              1.05,
              1.25
            ],
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "title": "Hot Spread",
            "type": "array"
          },
          "latency_gc_s": {
            "default": [
              1.0,
              3.0
            ],
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "title": "Latency Gc S",
            "type": "array"
          },
          "latency_special_s": {
            "default": [
              5.0,
              20.0
            ],
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "title": "Latency Special S",
            "type": "array"
          },
          "max_counters": {
            "default": 2,
            "title": "Max Counters",
            "type": "integer"
          },
          "prints_every_s": {
            "default": 15.0,
            "title": "Prints Every S",
            "type": "number"
          },
          "warm_spread": {
            "default": [
              1.0,
              1.1
            ],
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "title": "Warm Spread",
            "type": "array"
          }
        },
        "title": "VenueConfig",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Simulated electronic sec-lending venue: lender availability feed, last prints, BID/OFFER/COUNTER/ACCEPT/CANCEL/FIRM_BID orders, execution ledger with UTIs, and a FIX 4.4 session (default port 9878).\n\n**Simulator for demonstration only. Not affiliated with or endorsed by EquiLend, Wematch, FIS or Bloomberg; all names are trademarks of their respective owners. All data is synthetic.**",
    "title": "Venue A (NGT-style) \u2014 mock-ngt",
    "version": "0.1.0"
  },
