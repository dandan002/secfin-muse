<?xml version="1.0" encoding="UTF-8"?>
<!--
  Subset of ISO 20022 sese.023.001.09 (SecuritiesSettlementTransactionInstruction) for the LoanDesk
  mock custodian. Only the fields the simulator uses; securities-lending legs are flagged with
  SctiesTxTp SECL (loan) / SECB (borrow) / RTRN... see the codes in the enumeration below.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="urn:iso:std:iso:20022:tech:xsd:sese.023.001.09"
           targetNamespace="urn:iso:std:iso:20022:tech:xsd:sese.023.001.09"
           elementFormDefault="qualified">
  <xs:simpleType name="Max35Text">
    <xs:restriction base="xs:string"><xs:minLength value="1"/><xs:maxLength value="35"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ISINOct2015Identifier">
    <xs:restriction base="xs:string"><xs:pattern value="[A-Z]{2}[A-Z0-9]{9}[0-9]{1}"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="BICFIIdentifier">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Z0-9]{4}[A-Z]{2}[A-Z0-9]{2}([A-Z0-9]{3}){0,1}"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ReceiveDelivery1Code">
    <xs:restriction base="xs:string"><xs:enumeration value="DELI"/><xs:enumeration value="RECE"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="DeliveryReceiptType2Code">
    <xs:restriction base="xs:string"><xs:enumeration value="FREE"/><xs:enumeration value="APMT"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="SecuritiesTransactionType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="SECL"/> <!-- securities lending: loan leg -->
      <xs:enumeration value="SECB"/> <!-- securities borrowing: borrow leg -->
      <xs:enumeration value="SLRE"/> <!-- securities lending return / reimbursement -->
      <xs:enumeration value="SBRE"/> <!-- securities borrowing return / reimbursement -->
      <xs:enumeration value="TRAD"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="CreditDebitCode">
    <xs:restriction base="xs:string"><xs:enumeration value="CRDT"/><xs:enumeration value="DBIT"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="ActiveCurrencyCode">
    <xs:restriction base="xs:string"><xs:pattern value="[A-Z]{3}"/></xs:restriction>
  </xs:simpleType>
  <xs:complexType name="DateChoice">
    <xs:sequence>
      <xs:element name="Dt"><xs:complexType><xs:sequence>
        <xs:element name="Dt" type="xs:date"/>
      </xs:sequence></xs:complexType></xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="PartyBIC">
    <xs:sequence>
      <xs:element name="Pty1"><xs:complexType><xs:sequence>
        <xs:element name="Id"><xs:complexType><xs:sequence>
          <xs:element name="AnyBIC" type="BICFIIdentifier"/>
        </xs:sequence></xs:complexType></xs:element>
        <xs:element name="LEI" type="xs:string" minOccurs="0"/>
      </xs:sequence></xs:complexType></xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="Document">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="SctiesSttlmTxInstr">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="TxId" type="Max35Text"/>
              <xs:element name="SttlmTpAndAddtlParams">
                <xs:complexType><xs:sequence>
                  <xs:element name="SctiesMvmntTp" type="ReceiveDelivery1Code"/>
                  <xs:element name="Pmt" type="DeliveryReceiptType2Code"/>
                  <xs:element name="CmonId" type="Max35Text" minOccurs="0"/>
                </xs:sequence></xs:complexType>
              </xs:element>
              <xs:element name="TradDtls">
                <xs:complexType><xs:sequence>
                  <xs:element name="TradDt" type="DateChoice"/>
                  <xs:element name="SttlmDt" type="DateChoice"/>
                </xs:sequence></xs:complexType>
              </xs:element>
              <xs:element name="FinInstrmId">
                <xs:complexType><xs:sequence>
                  <xs:element name="ISIN" type="ISINOct2015Identifier"/>
                </xs:sequence></xs:complexType>
              </xs:element>
              <xs:element name="QtyAndAcctDtls">
                <xs:complexType><xs:sequence>
                  <xs:element name="SttlmQty"><xs:complexType><xs:sequence>
                    <xs:element name="Qty"><xs:complexType><xs:sequence>
                      <xs:element name="Unit" type="xs:decimal"/>
                    </xs:sequence></xs:complexType></xs:element>
                  </xs:sequence></xs:complexType></xs:element>
                  <xs:element name="SfkpgAcct"><xs:complexType><xs:sequence>
                    <xs:element name="Id" type="Max35Text"/>
                  </xs:sequence></xs:complexType></xs:element>
                </xs:sequence></xs:complexType>
              </xs:element>
              <xs:element name="SttlmParams">
                <xs:complexType><xs:sequence>
                  <xs:element name="SctiesTxTp"><xs:complexType><xs:sequence>
                    <xs:element name="Cd" type="SecuritiesTransactionType"/>
                  </xs:sequence></xs:complexType></xs:element>
                </xs:sequence></xs:complexType>
              </xs:element>
              <xs:element name="DlvrgSttlmPties" type="PartyBIC"/>
              <xs:element name="RcvgSttlmPties" type="PartyBIC"/>
              <xs:element name="SttlmAmt" minOccurs="0">
                <xs:complexType><xs:sequence>
                  <xs:element name="Amt"><xs:complexType><xs:simpleContent>
                    <xs:extension base="xs:decimal">
                      <xs:attribute name="Ccy" type="ActiveCurrencyCode" use="required"/>
                    </xs:extension>
                  </xs:simpleContent></xs:complexType></xs:element>
                  <xs:element name="CdtDbtInd" type="CreditDebitCode"/>
                </xs:sequence></xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
