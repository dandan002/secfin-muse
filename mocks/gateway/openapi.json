{
  "components": {
    "schemas": {
      "ClockPush": {
        "properties": {
          "rev": {
            "title": "Rev",
            "type": "integer"
          },
          "state": {
            "additionalProperties": true,
            "title": "State",
            "type": "object"
          }
        },
        "required": [
          "state",
          "rev"
        ],
        "title": "ClockPush",
        "type": "object"
      },
      "DecisionIn": {
        "properties": {
          "lines": {
            "items": {
              "$ref": "#/components/schemas/LineDecision"
            },
            "minItems": 1,
            "title": "Lines",
            "type": "array"
          },
          "locateId": {
            "title": "Locateid",
            "type": "string"
          }
        },
        "required": [
          "locateId",
          "lines"
        ],
        "title": "DecisionIn",
        "type": "object"
      },
      "FaultConfig": {
        "properties": {
          "drop_pct": {
            "default": 0.0,
            "description": "Outbound messages silently dropped",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Drop Pct",
            "type": "number"
          },
          "dup_pct": {
            "default": 0.0,
            "description": "Outbound messages sent twice",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Dup Pct",
            "type": "number"
          },
          "error_pct": {
            "default": 0.0,
            "description": "Non-admin requests fail with 500",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Error Pct",
            "type": "number"
          },
          "jitter_ms": {
            "default": 0,
            "maximum": 60000.0,
            "minimum": 0.0,
            "title": "Jitter Ms",
            "type": "integer"
          },
          "latency_ms": {
            "default": 0,
            "description": "Added latency on every non-admin request",
            "maximum": 60000.0,
            "minimum": 0.0,
            "title": "Latency Ms",
            "type": "integer"
          },
          "outage": {
            "default": false,
            "description": "All non-admin endpoints return 503; sessions refuse logon",
            "title": "Outage",
            "type": "boolean"
          },
          "reorder_pct": {
            "default": 0.0,
            "description": "Outbound messages held and sent after the next",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Reorder Pct",
            "type": "number"
          }
        },
        "title": "FaultConfig",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LineDecision": {
        "properties": {
          "approvedQuantity": {
            "default": 0,
            "minimum": 0.0,
            "title": "Approvedquantity",
            "type": "integer"
          },
          "decision": {
            "enum": [
              "APPROVED",
              "PARTIAL",
              "REJECTED"
            ],
            "title": "Decision",
            "type": "string"
          },
          "expiresAt": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expiresat"
          },
          "indicativeFeeBps": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Indicativefeebps"
          },
          "lineNo": {
            "title": "Lineno",
            "type": "integer"
          },
          "rationale": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rationale"
          },
          "regShoBasis": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Regshobasis"
          }
        },
        "required": [
          "lineNo",
          "decision"
        ],
        "title": "LineDecision",
        "type": "object"
      },
      "LoadgenIn": {
        "properties": {
          "base_per_min": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Base Per Min"
          },
          "burst_end": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Burst End"
          },
          "burst_mult": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Burst Mult"
          },
          "burst_start": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Burst Start"
          },
          "counterparties": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Counterparties"
          },
          "median_qty": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Median Qty"
          },
          "on": {
            "default": true,
            "title": "On",
            "type": "boolean"
          },
          "tier_mix": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "number"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tier Mix"
          }
        },
        "title": "LoadgenIn",
        "type": "object"
      },
      "OrderIn": {
        "properties": {
          "clientOrderId": {
            "title": "Clientorderid",
            "type": "string"
          },
          "feeBps": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Feebps"
          },
          "identifier": {
            "title": "Identifier",
            "type": "string"
          },
          "quantity": {
            "exclusiveMinimum": 0.0,
            "title": "Quantity",
            "type": "integer"
          },
          "settlementDate": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Settlementdate"
          },
          "side": {
            "enum": [
              "BORROW",
              "LOAN",
              "RETURN",
              "RECALL"
            ],
            "title": "Side",
            "type": "string"
          },
          "term": {
            "default": "OPEN",
            "enum": [
              "OPEN",
              "TERM"
            ],
            "title": "Term",
            "type": "string"
          }
        },
        "required": [
          "clientOrderId",
          "side",
          "identifier",
          "quantity"
        ],
        "title": "OrderIn",
        "type": "object"
      },
      "ResetRequest": {
        "properties": {
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed"
          }
        },
        "title": "ResetRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
