{
  "components": {
    "schemas": {
      "ClockPush": {
        "properties": {
          "rev": {
            "title": "Rev",
            "type": "integer"
          },
          "state": {
            "additionalProperties": true,
            "title": "State",
            "type": "object"
          }
        },
        "required": [
          "state",
          "rev"
        ],
        "title": "ClockPush",
        "type": "object"
      },
      "FaultConfig": {
        "properties": {
          "drop_pct": {
            "default": 0.0,
            "description": "Outbound messages silently dropped",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Drop Pct",
            "type": "number"
          },
          "dup_pct": {
            "default": 0.0,
            "description": "Outbound messages sent twice",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Dup Pct",
            "type": "number"
          },
          "error_pct": {
            "default": 0.0,
            "description": "Non-admin requests fail with 500",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Error Pct",
            "type": "number"
          },
          "jitter_ms": {
            "default": 0,
            "maximum": 60000.0,
            "minimum": 0.0,
            "title": "Jitter Ms",
            "type": "integer"
          },
          "latency_ms": {
            "default": 0,
            "description": "Added latency on every non-admin request",
            "maximum": 60000.0,
            "minimum": 0.0,
            "title": "Latency Ms",
            "type": "integer"
          },
          "outage": {
            "default": false,
            "description": "All non-admin endpoints return 503; sessions refuse logon",
            "title": "Outage",
            "type": "boolean"
          },
          "reorder_pct": {
            "default": 0.0,
            "description": "Outbound messages held and sent after the next",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Reorder Pct",
            "type": "number"
          }
        },
        "title": "FaultConfig",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "InstructionIn": {
        "description": "JSON convenience form; the custodian builds the sese.023 itself and runs the same flow.",
        "properties": {
          "account": {
            "default": "LOANDESK-SAFE-01",
            "title": "Account",
            "type": "string"
          },
          "amount": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Amount"
          },
          "ccy": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ccy"
          },
          "commonId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Commonid"
          },
          "counterpartyBic": {
            "title": "Counterpartybic",
            "type": "string"
          },
          "instrument": {
            "title": "Instrument",
            "type": "string"
          },
          "movement": {
            "enum": [
              "RECE",
              "DELI"
            ],
            "title": "Movement",
            "type": "string"
          },
          "payment": {
            "default": "FREE",
            "enum": [
              "FREE",
              "APMT"
            ],
            "title": "Payment",
            "type": "string"
          },
          "quantity": {
            "exclusiveMinimum": 0.0,
            "title": "Quantity",
            "type": "integer"
          },
          "settlementDate": {
            "format": "date",
            "title": "Settlementdate",
            "type": "string"
          },
          "tradeDate": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tradedate"
          },
          "txId": {
            "maxLength": 35,
            "title": "Txid",
            "type": "string"
          },
          "txType": {
            "enum": [
              "SECL",
              "SECB",
              "SLRE",
              "SBRE",
              "TRAD"
            ],
            "title": "Txtype",
            "type": "string"
          }
        },
        "required": [
          "txId",
          "movement",
          "txType",
          "instrument",
          "quantity",
          "settlementDate",
          "counterpartyBic"
        ],
        "title": "InstructionIn",
        "type": "object"
      },
      "ResetRequest": {
        "properties": {
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed"
          }
        },
        "title": "ResetRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
