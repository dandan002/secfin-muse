<?xml version="1.0" encoding="UTF-8"?>
<!-- Subset of ISO 20022 Business Application Header head.001.001.02 for the LoanDesk mock custodian. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="urn:iso:std:iso:20022:tech:xsd:head.001.001.02"
           targetNamespace="urn:iso:std:iso:20022:tech:xsd:head.001.001.02"
           elementFormDefault="qualified">
  <xs:simpleType name="BICFIIdentifier">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Z0-9]{4}[A-Z]{2}[A-Z0-9]{2}([A-Z0-9]{3}){0,1}"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="Max35Text">
    <xs:restriction base="xs:string"><xs:minLength value="1"/><xs:maxLength value="35"/></xs:restriction>
  </xs:simpleType>
  <xs:complexType name="Party">
    <xs:sequence>
      <xs:element name="FIId">
        <xs:complexType><xs:sequence>
          <xs:element name="FinInstnId">
            <xs:complexType><xs:sequence>
              <xs:element name="BICFI" type="BICFIIdentifier"/>
            </xs:sequence></xs:complexType>
          </xs:element>
        </xs:sequence></xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="AppHdr">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Fr" type="Party"/>
        <xs:element name="To" type="Party"/>
        <xs:element name="BizMsgIdr" type="Max35Text"/>
        <xs:element name="MsgDefIdr" type="Max35Text"/>
        <xs:element name="CreDt" type="xs:dateTime"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
