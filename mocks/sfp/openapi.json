{
  "components": {
    "schemas": {
      "AmendIn": {
        "properties": {
          "fields": {
            "additionalProperties": true,
            "description": "e.g. {'feeBps': 650} or {'settlementDate': '2026-10-28'}",
            "title": "Fields",
            "type": "object"
          },
          "reason": {
            "default": "",
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "fields"
        ],
        "title": "AmendIn",
        "type": "object"
      },
      "ClockPush": {
        "properties": {
          "rev": {
            "title": "Rev",
            "type": "integer"
          },
          "state": {
            "additionalProperties": true,
            "title": "State",
            "type": "object"
          }
        },
        "required": [
          "state",
          "rev"
        ],
        "title": "ClockPush",
        "type": "object"
      },
      "CompareIn": {
        "properties": {
          "contractId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Contract ID, UTI or venue ref; inferred from trade if omitted",
            "title": "Contractid"
          },
          "trade": {
            "additionalProperties": true,
            "description": "Our view of the trade: flat TradeIn fields or CDM-shaped",
            "title": "Trade",
            "type": "object"
          }
        },
        "required": [
          "trade"
        ],
        "title": "CompareIn",
        "type": "object"
      },
      "FaultConfig": {
        "properties": {
          "drop_pct": {
            "default": 0.0,
            "description": "Outbound messages silently dropped",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Drop Pct",
            "type": "number"
          },
          "dup_pct": {
            "default": 0.0,
            "description": "Outbound messages sent twice",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Dup Pct",
            "type": "number"
          },
          "error_pct": {
            "default": 0.0,
            "description": "Non-admin requests fail with 500",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Error Pct",
            "type": "number"
          },
          "jitter_ms": {
            "default": 0,
            "maximum": 60000.0,
            "minimum": 0.0,
            "title": "Jitter Ms",
            "type": "integer"
          },
          "latency_ms": {
            "default": 0,
            "description": "Added latency on every non-admin request",
            "maximum": 60000.0,
            "minimum": 0.0,
            "title": "Latency Ms",
            "type": "integer"
          },
          "outage": {
            "default": false,
            "description": "All non-admin endpoints return 503; sessions refuse logon",
            "title": "Outage",
            "type": "boolean"
          },
          "reorder_pct": {
            "default": 0.0,
            "description": "Outbound messages held and sent after the next",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Reorder Pct",
            "type": "number"
          }
        },
        "title": "FaultConfig",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LifecycleIn": {
        "properties": {
          "effectiveDate": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Effectivedate"
          },
          "event": {
            "enum": [
              "RETURN",
              "RECALL",
              "RERATE",
              "MARK"
            ],
            "title": "Event",
            "type": "string"
          },
          "feeBps": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Feebps"
          },
          "quantity": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Quantity"
          }
        },
        "required": [
          "event"
        ],
        "title": "LifecycleIn",
        "type": "object"
      },
      "ResetRequest": {
        "properties": {
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed"
          }
        },
        "title": "ResetRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Simulated securities-finance processor: booking, positions, lifecycle, compare, marks, EOD file.\n\n**Simulator for demonstration only. Not affiliated with or endorsed by EquiLend, Wematch, FIS or Bloomberg; all names are trademarks of their respective owners. All data is synthetic.**",
    "title": "Processor (FIS-style) \u2014 mock-sfp",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
