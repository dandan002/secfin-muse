# cp terraform.tfvars.example demo.tfvars, then: ../../deploy.sh -var-file=demo.tfvars
hosted_zone_name = "example.com"
domain_name      = "mocks.example.com"
allowed_cidrs    = ["203.0.113.10/32"] # your office / VPN egress; never 0.0.0.0/0

# budget_email   = "you@example.com"
# llm_mode       = "replay"            # off | replay | record | live
# meta_ai_api_key = "..."              # or TF_VAR_meta_ai_api_key; only needed for record/live
# nat_gateway    = true                # tasks in private subnets (+~$33/mo)
# running        = false               # park the stack between demos
