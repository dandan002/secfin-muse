+def s1(size: int, p: float, fee: int = 0, senior: float = 0.05) -> dict[str, Any]:
+    """System-one answers: ``size`` (0 decline .. 4 all of fillable) at probability ``p``, the fee near-certain."""
+    rest = (1 - p) / 4
+    return {"size": {"type": "score", "probabilities": {str(i): p if i == size else rest for i in range(5)}},
+            "fee": {"type": "score", "probabilities": {str(i): 0.97 if i == fee else 0.01 for i in range(4)}},
+            "senior": {"type": "noul", "noul": senior}}
