+    history = facts["feeHistory"]
+    tiers = sorted({h["tier"] for h in history if h.get("tier")})
+    signals = "; ".join(f"{x['level']}: {x['signal']} ({x['detail']})" for x in facts["signals"]) or "none"
+    return "\n".join([
+        f"Locate request: {req:,} shares of {loc['instrument']['composite']} (tier {loc['instrument']['tier']}) "
+        f"for {loc['counterparty']} ({room.get('kind')}).",
+        f"fillableQty: {fillable(facts):,} (counterparty maxQty {room.get('maxQty', 0):,}; failing limits: "
+        f"{'; '.join(room.get('failing') or []) or 'none'}).",
+        f"Availability: {mkt['available']:,} ({by.get('internal', 0):,} internal firm, {by.get('street', 0):,} "
+        f"street) from {(mkt.get('venueA') or {}).get('lenders')} street lenders; the desk already holds "
+        f"{mkt['held']:,} of {mkt['supply']:,} total supply.",
+        f"Request is {req / max(mkt['available'], 1):.1%} of available; days to cover {mkt.get('daysToCover')}.",
+        f"Utilization: {mkt['utilPct']}% now; {_span(history, 'utilPct')}.",
+        f"Fee: market {loc['instrument']['feeBps']} bps; daily closes {_span(history, 'feeBps')} bps; "
+        f"tiers seen: {tiers}.",
+        f"Desk floor: {pricing.get('floorBps')} bps.",
+        f"Rules-engine signals: {signals}"])
+
+
+def system1_proposal(facts: dict[str, Any], answers: dict[str, Any], confident_at: float) -> dict[str, Any]:
+    """The decision model's probabilities as a desk decision, and whether it may stand without Muse."""
+    loc, mkt, room = facts["locate"], facts["market"], facts["counterparty"] or {}
+    req, fill = loc["qtyRequested"], fillable(facts)
+    size_k, p = _argmax(answers["size"])
+    fee_k, p_fee = _argmax(answers["fee"])
+    share, markup = SIZES[size_k], MARKUPS[fee_k]
+    senior = float(answers["senior"]["noul"])
+    floor = (facts.get("pricing") or {}).get("floorBps") or loc["instrument"]["feeBps"]
+    fee = round(floor * (1 + markup), 1)
+    qty = fill if share == 1.0 or fill < 1000 else int(fill * share) // 1000 * 1000
+    qty = 0 if share == 0.0 else qty
+    decision = "REJECTED" if qty == 0 else "APPROVED" if qty >= req else "PARTIAL"
+    why: list[str] = []
+    if p < confident_at:
+        why.append(f"size at p {p:.2f} under {confident_at:g}")
+    if senior >= 0.5:
+        why.append(f"asked for a senior reviewer (p {senior:.2f})")
+    if loc["instrument"]["tier"] == "HOT":
+        why.append("hot name")
+    if room.get("failing"):
+        why.append("over counterparty limits")
+    issues = [f"{x['signal']} ({x['detail']})" for x in facts["signals"] if x["level"] == "issue"]
+    by = mkt.get("availableBy") or {}
+    d = {"decision": decision, "quantity": qty, "feeBps": fee,
+         "assessment": {
+             "availability": (f"{mkt['available']:,} available ({by.get('internal', 0):,} internal, "
+                              f"{by.get('street', 0):,} street) against {req:,}; fillable {fill:,}"),
+             "utilization": f"{mkt['utilPct']}% now; {_span(facts['feeHistory'], 'utilPct')}",
+             "feeHistory": f"{_span(facts['feeHistory'], 'feeBps')} bps"},
+         "reasoning": json.dumps({k: v.get("probabilities", v) for k, v in answers.items()}),
+         "rationale": (f"System one: {decision.lower()} {qty:,} of {req:,} ({share:.0%} of fillable {fill:,}, "
+                       f"p {p:.2f}) at {fee:g} bps, {markup:.0%} over the {floor:g} floor (p {p_fee:.2f})."),
+         "confidence": p, "riskFlags": issues, "escalate": False}
+    return {"decision": d, "confident": not why, "why": why, "answers": answers, "fillable": fill}
+
+
+async def system1(state: ReviewState) -> dict[str, Any]:
+    """One decision-model call on the whole case. Decides alone only when confident, in ``decide`` mode."""
+    cfg = get_settings()
+    facts = state["facts"]
+    try:
+        resp = await gateway().systemone(state={"desk_brief": S1_BRIEF, "case": case_summary(facts)},
+                                         questions=S1_QUESTIONS, model=cfg.system1_model)
