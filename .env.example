# Copy to .env and uncomment what you need. Nothing here is required for local dev against the mocks.
# The desk API reads LOANDESK_* from this file. Every other setting and its default is in
# platform/api/loandesk/settings.py.

# -- models ---------------------------------------------------------------------------------------
# Meta (Muse) models, used by the desk's agent and by the IB mock's chat personas.
# The desk also accepts this key as LOANDESK_MODEL_API_KEY.
# META_AI_API=
# Baseten: nothing reads this yet; it's kept for later. Direct calls send the header "Authorization: Api-Key <key>".
# BASETEN_API_KEY=
# OpenRouter: for the System One evaluation (see platform/docs/system-one).
# OPENROUTER_API_KEY=
# off | replay | record | live. With off, no model is ever called.
# LOANDESK_AGENT_MODE=off

# -- sign-in (Clerk) ------------------------------------------------------------------------------
# Your Clerk instance's Frontend API URL. If unset, the desk API is open to anyone (local dev only).
# The web app's publishable key goes in platform/web/.env.local (see platform/web/.env.example).
# LOANDESK_CLERK_ISSUER=https://your-instance.clerk.accounts.dev

# -- desk database --------------------------------------------------------------------------------
# SQLite by default. Postgres also works, e.g. postgresql+asyncpg://user@host:5432/loandesk
# LOANDESK_DATABASE_URL=sqlite+aiosqlite:///./loandesk.db

# -- the mocks ------------------------------------------------------------------------------------
# One database per mock service: {service} is replaced by each service's name.
# MOCK_DATABASE_URL=postgresql+asyncpg://postgres@127.0.0.1:5432/loandesk_{service}
# Guards each mock's /_admin routes; the desk sends it to fetch the mocks' credentials. Unset means no check.
# MOCK_ADMIN_TOKEN=
# Speeds up mapping new names to FIGIs when refreshing the mocks' reference data (free key).
# OPENFIGI_API_KEY=
